ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://fintrack:fintrack@localhost:5432/fintrack

# Chave de assinatura dos JWT. O valor abaixo serve APENAS para desenvolvimento
# local — a app recusa-se a arrancar com ele fora de ENVIRONMENT=development.
# Gera um real com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-before-any-real-deployment-0000

# Recuperação de password. Sem RESEND_API_KEY o link de reset é escrito no log do
# backend em vez de enviado por email — o fluxo funciona em dev sem configurar nada.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=CentiSible <onboarding@resend.dev>
# FRONTEND_BASE_URL=http://localhost:5173
