# Build em duas fases: a primeira instala dependências com uv (mais rápido),
# a segunda copia só o resultado (.venv + código) para uma imagem sem uv nem
# cache de downloads — imagem final mais pequena e sem ferramentas de build.
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
# --frozen: falha se uv.lock estiver desatualizado, em vez de o regravar
# silenciosamente numa imagem de produção. --no-dev: sem pytest/ruff/httpx.
RUN uv sync --frozen --no-dev

COPY app ./app


FROM python:3.12-slim

# Utilizador dedicado — o processo não precisa de privilégios de root para
# servir a API (não escreve em disco; a única persistência é o Postgres).
RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

COPY --from=builder /app/.venv ./.venv
COPY --from=builder /app/app ./app
COPY alembic.ini ./
COPY alembic ./alembic

ENV PATH="/app/.venv/bin:$PATH"

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

# Migrações aplicadas no arranque do container, antes do servidor aceitar
# pedidos — não há um passo de deployment separado nesta escala de projeto
# (um único container de backend, sem deploys concorrentes a disputar a
# mesma migração). UVICORN_WORKERS configurável por variável de ambiente;
# 2 é um valor de partida razoável para uma app pessoal de baixo tráfego.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2}"]
