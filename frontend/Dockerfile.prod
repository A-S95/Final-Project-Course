# Build em duas fases: a primeira compila a SPA para ficheiros estáticos, a
# segunda serve-os com nginx — a imagem final não tem Node nem o código-fonte,
# só HTML/CSS/JS já compilados.
FROM node:22-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# O Vite embebe VITE_API_URL no bundle em tempo de build (não é lido em
# runtime pelo browser) — por isso tem de vir como build arg, não como
# variável de ambiente do container final. Ver README para como definir isto
# ao construir a imagem para um domínio real.
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build


FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -qO- http://localhost/health || exit 1
