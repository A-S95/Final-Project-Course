# Variáveis de ambiente para docker-compose.prod.yml.
# Copiar para .env.prod e preencher com valores reais antes do primeiro deploy:
#   cp .env.prod.example .env.prod
#
# Nunca commitar o .env.prod preenchido (já está no .gitignore da raiz).

# Password do utilizador Postgres em produção — não reutilizar a de dev
# ("fintrack"), que só existe para desenvolvimento local.
POSTGRES_PASSWORD=

# Chave de assinatura dos JWT. Gerar com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Tem de ter pelo menos 32 caracteres e não pode conter substrings como
# "change"/"example"/"placeholder" — a app recusa-se a arrancar em
# ENVIRONMENT=production com uma chave que pareça um valor por omissão
# esquecido (ver app/core/config.py).
SECRET_KEY=

# Origem pública do frontend, para o CORS do backend. Formato de lista JSON,
# tal como no .env de desenvolvimento.
CORS_ORIGINS=["https://app.exemplo.com"]

# URL pública da API, embebida no bundle do frontend em tempo de build (ver
# frontend/Dockerfile.prod — o Vite não lê isto em runtime).
VITE_API_URL=https://api.exemplo.com

# Opcional — número de workers do uvicorn (default: 2 se omitido).
UVICORN_WORKERS=2
